# Copy to .env and fill in. Never commit the real .env.

PORT=3000
CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Session tokens (use long random strings, different for user and admin)
JWT_KEY=
JWT_KEY_ADMIN=

# Cloudinary (product, category and banner images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay payments
RZPAY_KEY=
RZPAY_KEY_SECRET=

# Transactional email (Gmail + App Password)
EMAIL_USER=
APP_SPECIFIC_PASSWORD=

# SMS OTP (Spring Edge)
SPRING_EDGE_KEY=

# Shipping aggregator API
PUBLIC_KEY_SHIP=
PRIVATE_KEY_SHIP=

# Google OAuth (optional)
CLIENT_ID=
CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
